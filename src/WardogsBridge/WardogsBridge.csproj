<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.0</Version>
    <Product>Wardogs Vehicle Radio</Product>
    <Description>Community vehicle radio mixer with automatic push-to-talk.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup><PackageReference Include="NAudio" Version="2.2.1" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="Assets/vehicle-radio.png" /></ItemGroup>
</Project>
